    "@radix-ui/react-select": "^2.3.3",
    "lucide-react": "latest",
    "next": "16.2.11",
    "pg": "8.22.0",
    "pg-cloudflare": "1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.114.0"
